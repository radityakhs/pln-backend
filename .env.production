# ============================================
# PRODUCTION ENVIRONMENT - Hostinger Deployment
# ============================================
# Copy this file to .env on the server and fill in real values
# cp .env.production .env

# --- MySQL Configuration (Hostinger) ---
# Hostname dari kontrol panel Hostinger Anda
MYSQL_HOST=srv2262.hstgr.io
# Username MySQL yang Anda buat di Hostinger
MYSQL_USER=u645087930_sa
# Password MySQL yang Anda buat di Hostinger
MYSQL_PASSWORD=Pln4usql
# Nama database yang sudah Anda buat (misal: pln_profile)
MYSQL_DATABASE=u645087930_pln_profile
MYSQL_PORT=3306

# --- Server Port ---
# Port untuk aplikasi Node.js (jangan pakai 3000/80, gunakan port custom)
PORT=3001

# --- CORS Configuration ---
# Sementara pakai '*' untuk testing (izinkan semua origin)
# Setelah deploy, ganti dengan domain frontend spesifik:
# CORS_ORIGIN=https://silver-dotterel-494244.hostingersite.com
CORS_ORIGIN=*

# --- Email Configuration (Gmail SMTP) ---
# Email resmi PLN4U
EMAIL_USER=pln4usaumlaki@gmail.com
# App Password Gmail (bukan password biasa)
EMAIL_PASS=your_gmail_app_password
# Email tujuan untuk form kontak
CONTACT_EMAIL=pln4usaumlaki@gmail.com
# SMTP Host
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
